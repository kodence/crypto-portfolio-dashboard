# Optional. The dashboard works without any key on CoinGecko's public free tier.
# Set this only if you have a CoinGecko Demo API key and want higher rate limits.
# COINGECKO_API_KEY=CG-xxxxxxxxxxxxxxxx

# Optional overrides
# COINGECKO_API_BASE=https://api.coingecko.com/api/v3
# PORT=3000

# Escape hatch for unattended runs (npm run dev, cron, CI). Setting this SKIPS the
# startup prompt and puts your passphrase on disk next to the encrypted portfolio,
# which defeats most of the point of encrypting it. Prefer `npm start` and type it.
# Only `npm run dev` reads this file; `npm start` never does.
# PORTFOLIO_PASSPHRASE=...
